{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": true,
  "default_agent": "plan",
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "agent": {
    "build": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "variant": "high",
      "temperature": 0.2,
    },
    "plan": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "variant": "high",
      "temperature": 0.0,
    },
  },
}
