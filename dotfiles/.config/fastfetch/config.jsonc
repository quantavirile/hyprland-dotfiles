// Inspired by Catnap
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#31} user    {#keys}│",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "│ {#32}󰇅 hname   {#keys}│",
      "type": "title",
      "format": "{host-name}",
    },
    {
      "type": "command",
      "key": "│ {#33}󱦟 os age  {#keys}|",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days",
    },
    {
      "type": "command",
      "key": "│ {#33}󰚰 updated {#keys}│",
      "text": "last=$(awk '/starting full system upgrade/{tmp=$1;gsub(/[][]/,\"\",tmp)} /transaction completed/{t=tmp;ok=1} /transaction interrupted/{ok=0} END{if(ok&&t)print t}' /var/log/pacman.log) && echo $(( ($(date +%s) - $(date -d \"$last\" +%s)) / 86400 )) days"
    },
    {
      "key": "│ {#37}󰅐 uptime  {#keys}│",
      "type": "uptime",
    },
    {
      "key": "│ {#34}{icon} distro  {#keys}│",
      "type": "os",
    },
    {
      "key": "│ {#35} kernel  {#keys}│",
      "type": "kernel",
    },
    {
      "key": "│ {#36} wm      {#keys}│",
      "type": "wm",
    },
    {
      "key": "│ {#33}󰏖 packages{#keys}│",
      "type": "packages",
    },
    {
      "key": "│ {#31} terminal{#keys}│",
      "type": "terminal",
    },
    {
      "key": "│ {#32} shell   {#keys}│",
      "type": "shell",
    },
    {
      "key": "│ {#33}󰍛 cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      "key": "│ {#34}󰉉 disk    {#keys}│",
      "type": "disk",
      "folders": "/",
    },
    {
      "key": "│ {#36} memory  {#keys}│",
      "type": "memory",
    },
    {
      "key": "├───────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#39} colors  {#keys}│",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
    },
  ],
}
