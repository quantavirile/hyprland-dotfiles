// Inspired by Catnap
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#34} user    {#keys}│",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "│ {#34}󰇅 hname   {#keys}│",
      "type": "title",
      "format": "{host-name}",
    },
    {
      "condition": {
        // Conditional module: only show on non-macOS
        "!system": "macOS",
      },
      "type": "disk",
      "keyIcon": "",
      "key": "│{#34} {icon} os age {#keys} │",
      // "keyColor": "magenta",
      "folders": "/", // Check root filesystem
      "format": "{create-time:10} [{days} days ({years} years)]", // Show creation time and age in days
    },
    {
      "type": "command",
      "key": "│ {#34}󰚰 updated {#keys}│",
      "text": "last=$(awk '/starting full system upgrade/{tmp=$1;gsub(/[][]/,\"\",tmp)} /transaction completed/{t=tmp;ok=1} /transaction interrupted/{ok=0} END{if(ok&&t)print t}' /var/log/pacman.log) && echo $(( ($(date +%s) - $(date -d \"$last\" +%s)) / 86400 )) days",
    },
    {
      "key": "│ {#34}󰅐 uptime  {#keys}│",
      "type": "uptime",
    },
    {
      "key": "│ {#34}{icon} distro  {#keys}│",
      "type": "os",
    },
    {
      "key": "│ {#34} kernel  {#keys}│",
      "type": "kernel",
    },
    {
      "key": "│ {#34} wm      {#keys}│",
      "type": "wm",
    },
    {
      "key": "│ {#34}󰇄 desktop {#keys}│",
      "type": "de",
    },
    {
      "key": "│ {#34}󰏖 packages{#keys}│",
      "type": "packages",
    },
    {
      "key": "│ {#34} terminal{#keys}│",
      "type": "terminal",
    },
    {
      "key": "│ {#34} shell   {#keys}│",
      "type": "shell",
    },
    {
      "key": "│ {#34}󰍛 cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      "key": "│ {#34}󰉉 disk    {#keys}│",
      "type": "disk",
      "folders": "/",
    },
    {
      "key": "│ {#34}󰉉 disk    {#keys}│",
      "type": "disk",
      "folders": "/home",
    },
    {
      "key": "│ {#34} memory  {#keys}│",
      "type": "memory",
    },
    {
      "key": "├───────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#34} colors  {#keys}│",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
    },
  ],
}
